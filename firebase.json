{
  "hosting": {
    "public": "firebase-public",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "cleanUrls": true,
    "trailingSlash": false,
    "headers": [
      {
        "source": "**/*.@(js|css)",
        "headers": [
          { "key": "Cache-Control", "value": "public,max-age=3600" }
        ]
      },
      {
        "source": "**/*.@(png|svg)",
        "headers": [
          { "key": "Cache-Control", "value": "public,max-age=604800" }
        ]
      }
    ]
  },
  "firestore": {
    "rules": "firestore.rules"
  }
}
